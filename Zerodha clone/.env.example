# Create a dedicated Supabase project for this app. Do not use the travel website project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional broker adapter credentials. Keep secrets server-side only.
BROKER_MODE=paper
KITE_API_KEY=
KITE_API_SECRET=
KITE_REDIRECT_URL=http://localhost:3000/api/broker/kite/callback
# Real order placement intentionally remains disabled in this starter.
LIVE_TRADING_ENABLED=false
